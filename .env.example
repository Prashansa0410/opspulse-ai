# OpsPulse AI Environment Configuration Example
APP_NAME=OpsPulse AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Data Volume: small (3k orders), medium (25k orders), large (150k orders)
DATA_VOLUME=small
RANDOM_SEED=42

# Ports
HOST=0.0.0.0
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# AI / LLM Keys (Optional - Agent uses deterministic AST tool runner if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Database & Streaming
DATABASE_URL=duckdb:///data/opspulse.duckdb
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
